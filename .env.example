# Get this from @BotFather on Telegram
BOT_TOKEN=123456789:AAExampleTokenGoesHere

# Your Render service URL, set AFTER first deploy, e.g.:
# https://instasave-bot.onrender.com
WEBHOOK_BASE_URL=

# Optional - leave blank to auto-derive from BOT_TOKEN
WEBHOOK_SECRET=

# Optional tuning
RATE_LIMIT_COUNT=8
RATE_LIMIT_WINDOW=60
MAX_DOWNLOAD_MB=45
